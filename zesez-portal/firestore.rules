// Zesez Education — Firestore Təhlükəsizlik Qaydaları
// Firebase Console > Firestore Database > Rules bölməsinə köçürün.
// Hər istifadəçi yalnız öz sənədini oxuya/yaza bilər.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
